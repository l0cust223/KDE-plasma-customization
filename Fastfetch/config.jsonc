{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
         "source": "~/Downloads/denji.png",
         "type": "auto",
         "height": 15,
         "width": 32,
         "padding": {
             "top": 2,
             "right": 6,
             "left": 4
         }
     },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────Hardware─────────────────────────────┐"
        },

        {
            "type": "host",
            "key": "󰌢 Laptop",
            "keyColor": "white",
            "format": "{name}"
        },
        {
            "type": "display",
            "key": "│ ├ Display",
            "keyColor": "white",
            "format": "{width}*{height} @{refresh-rate}Hz {inch}″"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 CPU",
            "keyColor": "white",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛 GPU",
            "keyColor": "white",
            "format": "{vendor} {name}"
        },
        {
            "type": "disk",
            "key": "│ ├ Disk",
            "keyColor": "white",
            "format": "{size-used} / {size-total} ({size-percentage}) {filesystem}"
        },
        {
            "type": "memory",
            "key": "│ └󰘚 RAM",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────Software─────────────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "white"
        },
        {
            "type": "de",
            "key": "│ ├ DE",
            "keyColor": "white"
        },
        {
            "type": "wm",
            "key": "│ ├ VM",
            "keyColor": "white"
        },
        {
            "type": "kernel",
            "key": "│ ├ Kernel",
            "keyColor": "white"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 Packages",
            "keyColor": "white"
        },
        {
            "type": "shell",
            "key": "│ └ Shell",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 15,
            "symbol": "circle",
            "block": {
                "width": 20
            }
        }
    ]
}
